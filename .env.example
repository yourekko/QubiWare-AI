# Copy to .env for local runs. On Streamlit Community Cloud, set these in App → Secrets instead.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: AI_PROVIDER=gemini forces Gemini before OpenAI when both keys exist (default: OpenAI first).
# Optional: OPENAI_MODEL=gpt-4o-mini (default) or gpt-4o, etc.
# Optional: TABLE_WOW_DISABLE_OPENAI=1 skips OpenAI on intelligence tables (rule-based insights only; saves latency/cost).
